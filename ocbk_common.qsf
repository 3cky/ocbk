# ============================================================================
#  ocbk - common settings (device, sources, pin map)
#  BK-0010 CPU bring-up on the 1chipMSX / OneChipBook (EP1C12Q240C8).
#  Pin assignments copied from ocb-test / esemsx3 emsx_top_common.qsf.
# ============================================================================

# --- Device ---------------------------------------------------------------
set_global_assignment -name FAMILY Cyclone
set_global_assignment -name DEVICE EP1C12Q240C8
set_global_assignment -name STRATIX_DEVICE_IO_STANDARD LVTTL

# --- vm1 core configuration (global Verilog macros) -----------------------
# Quartus does not propagate `define across separately-listed Verilog files, so
# set the core defparam selectors as global macros. Mirrors src/cpu/vm1_config.v
# (used by the simulation flow). 0 = FF register file / microcode revision A.
set_global_assignment -name VERILOG_MACRO "CONFIG_VM1_CORE_REG_USES_RAM=0"
set_global_assignment -name VERILOG_MACRO "CONFIG_VM1_CORE_MULG_VERSION=0"

# --- Source files ---------------------------------------------------------
# vm1 core (vendored Verilog-2001)
set_global_assignment -name VERILOG_FILE src/cpu/vm1.v
set_global_assignment -name VERILOG_FILE src/cpu/vm1_qbus.v
# vm1_vcram_syn.v (synth stub) replaces the sim-only vm1_simlib.v; the FF
# register-file path leaves this RAM unused, so the stub is stripped.
set_global_assignment -name VERILOG_FILE src/cpu/vm1_vcram_syn.v
set_global_assignment -name VERILOG_FILE src/cpu/vm1_plm.v
set_global_assignment -name VERILOG_FILE src/cpu/vm1_tve.v
# ocbk SystemVerilog (package first)
set_global_assignment -name SYSTEMVERILOG_FILE src/qbus_pkg.sv
set_global_assignment -name SYSTEMVERILOG_FILE src/sdram_ctrl.sv
set_global_assignment -name SYSTEMVERILOG_FILE src/sdram_arbiter.sv
set_global_assignment -name SYSTEMVERILOG_FILE src/va_037_sync.sv
set_global_assignment -name SYSTEMVERILOG_FILE src/cpu_sdram_dp.sv
set_global_assignment -name SYSTEMVERILOG_FILE src/qbus_mem_sdram.sv
set_global_assignment -name SYSTEMVERILOG_FILE src/ps2_rx.sv
set_global_assignment -name SYSTEMVERILOG_FILE src/kbd_ps2bk.sv
set_global_assignment -name SYSTEMVERILOG_FILE src/bk_kbd014.sv
set_global_assignment -name SYSTEMVERILOG_FILE src/epcs_boot.sv
set_global_assignment -name SYSTEMVERILOG_FILE src/qbus_slot.sv
# Phase-4 video pipeline
set_global_assignment -name SYSTEMVERILOG_FILE src/palette_apply.sv
set_global_assignment -name SYSTEMVERILOG_FILE src/fb_video.sv
set_global_assignment -name SYSTEMVERILOG_FILE src/fb_readout.sv
set_global_assignment -name SYSTEMVERILOG_FILE src/fb_linebuf.sv
set_global_assignment -name SYSTEMVERILOG_FILE src/vga_timing.sv
set_global_assignment -name SYSTEMVERILOG_FILE src/vga_out.sv
set_global_assignment -name SYSTEMVERILOG_FILE src/bk_audio.sv
set_global_assignment -name SYSTEMVERILOG_FILE src/ocbk_top.sv

# --- Timing constraints ---------------------------------------------------
set_global_assignment -name SDC_FILE ocbk_constrains.sdc

# --- Unused pins / configuration device -----------------------------------
# Everything not assigned below - including the entire cartridge-slot block
# PIN_121-180 - is reserved as a tri-stated input.
set_global_assignment -name RESERVE_ALL_UNUSED_PINS "AS INPUT TRI-STATED"
set_global_assignment -name RESERVE_ALL_UNUSED_PINS_NO_OUTPUT_GND "AS INPUT TRI-STATED"
set_global_assignment -name RESERVE_ASDO_AFTER_CONFIGURATION "AS INPUT TRI-STATED"
set_global_assignment -name CYCLONE_CONFIGURATION_DEVICE EPCS4
set_global_assignment -name USE_CONFIGURATION_DEVICE ON
set_global_assignment -name GENERATE_RBF_FILE ON

# ==========================================================================
#  Pin locations
# ==========================================================================
# Clock
set_location_assignment PIN_28  -to pClk21m
# Green LEDs
set_location_assignment PIN_43  -to pLed[0]
set_location_assignment PIN_44  -to pLed[1]
set_location_assignment PIN_45  -to pLed[2]
set_location_assignment PIN_46  -to pLed[3]
set_location_assignment PIN_47  -to pLed[4]
set_location_assignment PIN_48  -to pLed[5]
set_location_assignment PIN_49  -to pLed[6]
set_location_assignment PIN_50  -to pLed[7]
# Red power LED
set_location_assignment PIN_240 -to pLedPwr
# DIP switches (copied from ocb-test / esemsx3; ON pulls low)
set_location_assignment PIN_53 -to pDip[0]
set_location_assignment PIN_54 -to pDip[1]
set_location_assignment PIN_55 -to pDip[2]
set_location_assignment PIN_56 -to pDip[3]
set_location_assignment PIN_57 -to pDip[4]
set_location_assignment PIN_58 -to pDip[5]
set_location_assignment PIN_59 -to pDip[6]
set_location_assignment PIN_60 -to pDip[7]
# Reset button = the slot RESET net (external pull-up; esemsx3 uses it the same
# way). Doubles as the slot RESET pin if the cartridge-slot seam is ever enabled.
set_location_assignment PIN_153 -to pSltRst_n
# PS/2 keyboard (esemsx3 emsx_top_common.qsf: pPs2Dat=PIN_67, pPs2Clk=PIN_68)
set_location_assignment PIN_67 -to pPs2Dat
set_location_assignment PIN_68 -to pPs2Clk
# VGA sync (copied from ocb-test / esemsx3: pVideoVS_n=PIN_74, pVideoHS_n=PIN_75)
set_location_assignment PIN_74 -to pVideoVS_n
set_location_assignment PIN_75 -to pVideoHS_n
# VGA RGB - 6-bit R-2R DAC per channel (esemsx3 pin order, bit0..bit5)
set_location_assignment PIN_95  -to pDac_VR[0]
set_location_assignment PIN_98  -to pDac_VR[1]
set_location_assignment PIN_99  -to pDac_VR[2]
set_location_assignment PIN_100 -to pDac_VR[3]
set_location_assignment PIN_101 -to pDac_VR[4]
set_location_assignment PIN_104 -to pDac_VR[5]
set_location_assignment PIN_85 -to pDac_VG[0]
set_location_assignment PIN_86 -to pDac_VG[1]
set_location_assignment PIN_87 -to pDac_VG[2]
set_location_assignment PIN_88 -to pDac_VG[3]
set_location_assignment PIN_93 -to pDac_VG[4]
set_location_assignment PIN_94 -to pDac_VG[5]
set_location_assignment PIN_77 -to pDac_VB[0]
set_location_assignment PIN_78 -to pDac_VB[1]
set_location_assignment PIN_79 -to pDac_VB[2]
set_location_assignment PIN_82 -to pDac_VB[3]
set_location_assignment PIN_83 -to pDac_VB[4]
set_location_assignment PIN_84 -to pDac_VB[5]
# Sound - 6-bit R-2R DAC per channel (esemsx3 pin order, bit0..bit5)
set_location_assignment PIN_105 -to pDac_SL[0]
set_location_assignment PIN_106 -to pDac_SL[1]
set_location_assignment PIN_107 -to pDac_SL[2]
set_location_assignment PIN_108 -to pDac_SL[3]
set_location_assignment PIN_113 -to pDac_SL[4]
set_location_assignment PIN_114 -to pDac_SL[5]
set_location_assignment PIN_115 -to pDac_SR[0]
set_location_assignment PIN_116 -to pDac_SR[1]
set_location_assignment PIN_117 -to pDac_SR[2]
set_location_assignment PIN_118 -to pDac_SR[3]
set_location_assignment PIN_119 -to pDac_SR[4]
set_location_assignment PIN_120 -to pDac_SR[5]

# ==========================================================================
#  I/O properties
# ==========================================================================
set_instance_assignment -name PCI_IO ON -to pClk21m
set_instance_assignment -name GLOBAL_SIGNAL "GLOBAL CLOCK" -to pClk21m

set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to pLed[0]
set_instance_assignment -name CURRENT_STRENGTH_NEW 4MA -to pLed[0]
set_instance_assignment -name PCI_IO ON -to pLed[0]
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to pLed[1]
set_instance_assignment -name CURRENT_STRENGTH_NEW 4MA -to pLed[1]
set_instance_assignment -name PCI_IO ON -to pLed[1]
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to pLed[2]
set_instance_assignment -name CURRENT_STRENGTH_NEW 4MA -to pLed[2]
set_instance_assignment -name PCI_IO ON -to pLed[2]
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to pLed[3]
set_instance_assignment -name CURRENT_STRENGTH_NEW 4MA -to pLed[3]
set_instance_assignment -name PCI_IO ON -to pLed[3]
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to pLed[4]
set_instance_assignment -name CURRENT_STRENGTH_NEW 4MA -to pLed[4]
set_instance_assignment -name PCI_IO ON -to pLed[4]
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to pLed[5]
set_instance_assignment -name CURRENT_STRENGTH_NEW 4MA -to pLed[5]
set_instance_assignment -name PCI_IO ON -to pLed[5]
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to pLed[6]
set_instance_assignment -name CURRENT_STRENGTH_NEW 4MA -to pLed[6]
set_instance_assignment -name PCI_IO ON -to pLed[6]
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to pLed[7]
set_instance_assignment -name CURRENT_STRENGTH_NEW 4MA -to pLed[7]
set_instance_assignment -name PCI_IO ON -to pLed[7]

set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to pLedPwr
set_instance_assignment -name CURRENT_STRENGTH_NEW 4MA -to pLedPwr

# DIP switch inputs (weak pull-up; mirrors ocb-test / esemsx3)
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to pDip[0]
set_instance_assignment -name PCI_IO ON -to pDip[0]
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to pDip[1]
set_instance_assignment -name PCI_IO ON -to pDip[1]
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to pDip[2]
set_instance_assignment -name PCI_IO ON -to pDip[2]
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to pDip[3]
set_instance_assignment -name PCI_IO ON -to pDip[3]
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to pDip[4]
set_instance_assignment -name PCI_IO ON -to pDip[4]
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to pDip[5]
set_instance_assignment -name PCI_IO ON -to pDip[5]
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to pDip[6]
set_instance_assignment -name PCI_IO ON -to pDip[6]
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to pDip[7]
set_instance_assignment -name PCI_IO ON -to pDip[7]

# Reset button (slot RESET, PIN_153): external pull-up on the board, so PCI_IO
# only (mirrors esemsx3 emsx_top_common.qsf).
set_instance_assignment -name PCI_IO ON -to pSltRst_n

# PS/2 keyboard pins: weak pull-ups + 4 mA, as esemsx3 (receive-only, the
# design drives them Z; the pull-ups keep the idle-high PS/2 levels)
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to pPs2Clk
set_instance_assignment -name CURRENT_STRENGTH_NEW 4MA -to pPs2Clk
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to pPs2Dat
set_instance_assignment -name CURRENT_STRENGTH_NEW 4MA -to pPs2Dat

# VGA sync outputs (24 mA, fast slew; mirrors ocb-test / esemsx3)
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to pVideoVS_n
set_instance_assignment -name CURRENT_STRENGTH_NEW 24MA -to pVideoVS_n
set_instance_assignment -name SLOW_SLEW_RATE OFF -to pVideoVS_n
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to pVideoHS_n
set_instance_assignment -name CURRENT_STRENGTH_NEW 24MA -to pVideoHS_n
set_instance_assignment -name SLOW_SLEW_RATE OFF -to pVideoHS_n

# VGA RGB DAC outputs (4 mA, weak pull-up; mirrors ocb-test / esemsx3)
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to pDac_VR
set_instance_assignment -name CURRENT_STRENGTH_NEW 4MA -to pDac_VR
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to pDac_VG
set_instance_assignment -name CURRENT_STRENGTH_NEW 4MA -to pDac_VG
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to pDac_VB
set_instance_assignment -name CURRENT_STRENGTH_NEW 4MA -to pDac_VB

# Sound DAC outputs (4 mA, weak pull-up; mirrors the video DAC / esemsx3)
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to pDac_SL
set_instance_assignment -name CURRENT_STRENGTH_NEW 4MA -to pDac_SL
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to pDac_SR
set_instance_assignment -name CURRENT_STRENGTH_NEW 4MA -to pDac_SR

# ==========================================================================
#  SDRAM (16-bit SDR; pins copied verbatim from ocb-test / esemsx3, board-proven)
# ==========================================================================
set_location_assignment PIN_38  -to pMemClk
set_location_assignment PIN_39  -to pMemCke
set_location_assignment PIN_197 -to pMemCs_n
set_location_assignment PIN_196 -to pMemRas_n
set_location_assignment PIN_195 -to pMemCas_n
set_location_assignment PIN_194 -to pMemWe_n
set_location_assignment PIN_223 -to pMemUdq
set_location_assignment PIN_193 -to pMemLdq
set_location_assignment PIN_200 -to pMemBa0
set_location_assignment PIN_201 -to pMemBa1
set_location_assignment PIN_203 -to pMemAdr[0]
set_location_assignment PIN_206 -to pMemAdr[1]
set_location_assignment PIN_207 -to pMemAdr[2]
set_location_assignment PIN_208 -to pMemAdr[3]
set_location_assignment PIN_235 -to pMemAdr[4]
set_location_assignment PIN_234 -to pMemAdr[5]
set_location_assignment PIN_233 -to pMemAdr[6]
set_location_assignment PIN_228 -to pMemAdr[7]
set_location_assignment PIN_227 -to pMemAdr[8]
