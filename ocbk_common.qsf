set_location_assignment PIN_214 -to pMemDat[14]
set_location_assignment PIN_213 -to pMemDat[15]

# SDRAM I/O properties (clock/cke get PCI_IO; data bus weak pull-ups; all 4 mA)
set_instance_assignment -name CURRENT_STRENGTH_NEW 4MA -to pMemClk
set_instance_assignment -name PCI_IO ON -to pMemClk
set_instance_assignment -name CURRENT_STRENGTH_NEW 4MA -to pMemCke
set_instance_assignment -name PCI_IO ON -to pMemCke
set_instance_assignment -name CURRENT_STRENGTH_NEW 4MA -to pMemCs_n
set_instance_assignment -name CURRENT_STRENGTH_NEW 4MA -to pMemRas_n
set_instance_assignment -name CURRENT_STRENGTH_NEW 4MA -to pMemCas_n
set_instance_assignment -name CURRENT_STRENGTH_NEW 4MA -to pMemWe_n
set_instance_assignment -name CURRENT_STRENGTH_NEW 4MA -to pMemUdq
set_instance_assignment -name CURRENT_STRENGTH_NEW 4MA -to pMemLdq
set_instance_assignment -name CURRENT_STRENGTH_NEW 4MA -to pMemBa0
set_instance_assignment -name CURRENT_STRENGTH_NEW 4MA -to pMemBa1
set_instance_assignment -name CURRENT_STRENGTH_NEW 4MA -to pMemAdr
set_instance_assignment -name CURRENT_STRENGTH_NEW 4MA -to pMemDat
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to pMemDat

# ==========================================================================
#  Cartridge-slot Q-bus pin map (FORWARD SEAM - commented out for Phase 1)
# ==========================================================================
# Uncomment together with qbus_slot SLOT_ENABLE=1 (and add the matching inout
# ports to ocbk_top) to bring the internal Q-bus out to the physical cartridge
# slot for real BK hardware. Pins from esemsx3 emsx_top_common.qsf (PIN_121-180,
# all unused by Phase 1). REQUIRES an external bidirectional 5V<->3.3V level-
# shifter: Cyclone I is 3.3V LVTTL, not 5V-tolerant (PCI clamp only).
#
#   ad_n[15:0] <-> pSltAdr[15:0]   PIN_164,163,166,165,168,167,158,156,
#                                   160,139,143,141,159,162,161,140
#   sync_n      -> pSltMerq_n  PIN_135      din_n  -> pSltRd_n   PIN_137
#   dout_n      -> pSltWr_n    PIN_136      wtbt_n -> pSltIorq_n PIN_134
#   rply_n     <-  pSltWait_n  PIN_128 (open-collector, board pull-up)
#   transceiver dir -> pSltBdir_n PIN_133
#   (DMA/IRQ/iako/init/sp/sel/bsy -> pSltDat[7:0] PIN_170..178 + spares
#    pSltRsv5/16 PIN_126/138, pSltSw1/2 PIN_179/180, pSltCs* PIN_122..124)
#
# set_location_assignment PIN_164 -to pSltAdr[0]
# set_location_assignment PIN_163 -to pSltAdr[1]
# ... (full block added at slot bring-up)
