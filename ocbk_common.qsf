set_location_assignment PIN_225 -to pMemAdr[11]
set_location_assignment PIN_224 -to pMemAdr[12]
set_location_assignment PIN_181 -to pMemDat[0]
set_location_assignment PIN_182 -to pMemDat[1]
set_location_assignment PIN_183 -to pMemDat[2]
set_location_assignment PIN_184 -to pMemDat[3]
set_location_assignment PIN_185 -to pMemDat[4]
set_location_assignment PIN_186 -to pMemDat[5]
set_location_assignment PIN_187 -to pMemDat[6]
set_location_assignment PIN_188 -to pMemDat[7]
set_location_assignment PIN_222 -to pMemDat[8]
set_location_assignment PIN_219 -to pMemDat[9]
set_location_assignment PIN_218 -to pMemDat[10]
set_location_assignment PIN_217 -to pMemDat[11]
