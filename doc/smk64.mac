; File Name   :	DISK_SMK64_v2.05.rom
; Format      :	Binary file
; Processor   :	PDP11

; Комментарии к модулю FDD взяты из листинга текста прошивка 326
; из ПК-БК #5'1994
; Комментарии к модулю HDD взяты из исходников прошивки v1.41 
; Комментарии к ROM-BIOSу взяты из исходников ROM-BIOSа

; ===========================================================================
;непонятные точки входа
;160062 - PARTRD
;160064 - SETPRM
;160100 - ZAGHDD загрузка с раздела винта по букве
;160154 - CRC

.ASect 
.=160000	;компилируем с адреса 160000

ERRFDD	= 52	;адрес, куда сохраняется номер ошибки

;ячейки рабочей области драйвера дисковода

CSRW	= 0	;копия по записи регистра состояния КНГМД
CURTRK	= 2	;адрес текущей дорожки (адрес одного из следующих байтов из таблицы)
TRKTAB	= 4	;таблица текущих дорожек
TDOWN	= 10	;задержка опускания головки
TSTEP	= 12	;задержка перехода с дорожки на дорожку
TRKCOR	= 14	;дорожка начала предкомпенсации
BRETRY	= 15	;число попыток повтора при ошибке
FLAGS	= 16	;рабочая ячейка драйвера
FILLB	= 17	;код заполнения при форматировании
FLGPTR	= 20	;указатель на байт признаков (адрес одного из следующих байтов из таблицы)
FLGTAB	= 22	;таблица признаков
ADDR	= 26	;адрес начала массива данных в ОЗУ (обязательно четный)
WCNT	= 30	;количество слов для пересылки
SIDE	= 32	;номер стороны диска
TRK	= 33	;номер дорожки
UNIT	= 34	;номер привода
SECTOR	= 35	;номер сектора
WRTVAR	= 36	;значение, записываемое при форматировании
MARKER	= 40	;буфер маркера при записи
FREE	= 42	;длина пустого остатка сектора
INTIME	= 44	;счетчик длительности индекса
BUF4	= 46	;буфер для сохранения вектора 4
BUFSP	= 50	;буфер для сохранения SP
BUFPSW	= 52	;буфер для сохранения PSW
CRETRY	= 54	;счетчик повторов при ошибке
TURNS	= 55	;число оборотов диска при поиске сектора
SECRET	= 56	;число повторных попыток поиска сектора
ERRNUM	= 57	;буфер для номера ошибки
MAXSEC	= 60	;число секторов на дорожке
HOLTIN	= 62	;время задержки после индекса
SECLEN	= 64	;длина сектора в словах

;константы блока работы с HDD
		;КОНСТАНТЫ
HD$TRK=176776		;всего дорожек
HD$DRV=176775		;код # привода,уст.внешним драйвером
HD$HEA=176774		;всего головок
HD$SEC=176772		;секторов на дорожке
HD$UNI=176771		;# устр. для загрузки по умолч.
HD$LOG=176770		;всего лог.дисков

HD$SPD=176000		;признак быстрого чтения (125252)
HD$USR=175776		;указатель на начало USR-драйвера
HD$EIS=175774		;указ. на нач.FIS/EIS др-ра; ...подряд!
HD$US1=175772		;указ.на нач. USR-1 (физич.чтен/зап)

HD$OZU=170000
HD$MBR=20000
		;РЕГИСТРЫ
R$STAT=177740		;статус
R$HEAD=177742		;головка
R$TRKH=177744		;дор.ст.б.
R$TRKL=177746		;дор.мл.б.
R$SECT=177750		;сектор
R$COUN=177752		;счетчик секторов
R$ERRR=177754		;ошибка
R$DATA=177756		;данные
R$SRES=177743		;Soft Reset
R$ADDR=177741		;адрес НЖМД (не	используется)

;Константы для ROM-BIOS
WRK$	= 120016
MAIN$	= 120012
CHWRK$	= 120022


BOOT0:	BR	BOOT0$		; Точка входа Автоматическая загрузка
BOOT1:	BR	BOOT1$		; Точка входа Загрузка с выбранного привода
RWBLK:	BR	RWBLK$		; Точка входа Чтение-запись по номеру блока
RWSEC:	BR	RWSEC$		; Точка входа Чтение-запись по номеру сектора
INITF:	BR	INIT$		; Точка входа Инициализация рабочей области
FORMAT:	JMP	FORMT$		; Точка входа Форматирование дорожки
EXT:	JMP	EISEML		; Точка входа Расширенная арифметика
; =============== S U B R O U T I N E =======================================
; BOOT0: П/п автоматической загрузки
BOOT0$:	MOV	(PC),R0		; сперва пробуем загрузиться с винта
	CALL	BOOTF$		; Пробуем загрузиться
	MOV	#100000,R0	; потом пробуем с привода 0
	CALL	BOOTF$		; Пробуем загрузиться
	MOV	#100001,R0	; потом - с привода 1
; =============== S U B R O U T I N E =======================================
; BOOT1: Загрузка с выбранного привода
BOOT1$:	CALL	BOOTF$		; Пробуем загрузиться
; STOP: Остановка двигателя НГМД и выход из п/п
	CLR	(R3)
	CLR	(R4)
	RETURN
; End of function BOOT1$
; End of function BOOT0$
; =============== S U B R O U T I N E =======================================
; RWSEC: Чтение-запись по номеру сектора
RWSEC$:	JMP	ABS$RD		;перехват функции
; End of function RWSEC$
; ---------------------------------------------------------------------------
	.WORD	PARTRD		; точка входа - 160062
	.WORD	SETPRM		; точка входа - 160064
; =============== S U B R O U T I N E =======================================
; BOOT: П/п загрузки и запуска загрузчика
BOOTF$:	MOV	#2000,R3	; Установим адрес рабочей области
	CALL	BOOT$		; Перехват функции для загрузки с винта
	BR	INIT$
; ---------------------------------------------------------------------------
	JMP	ZAGHDD		; Точка входа - 160100
; ---------------------------------------------------------------------------
; загрузка с дисковода
FLPLOD:				; Читаем нулевой блок
	MOV	#400,R1		;    длиной 400 слов (1000 байт)
	MOV	#1000,R2	;    с адреса 1000
	CALL	RWBLK$		; Прочитаем...
	BCS	1$		;    не получилось - выход
	CMP	@#1000,#240 	; Загрузчик начинается с NOP?
	BNE	1$		; Нет - выход
	CMP	@#1002,#5	; Вторая команда - RESET?
	BEQ	1$		; Да - диск не системный, выход
	MOVB	UNIT(R3),R0	; Вспомним, откуда это мы загрузились
	CALL	@#1000		; Запускаем загрузчик
1$:	RETURN			; Вот и все
; ---------------------------------------------------------------------------
		.WORD	CRC			; точка входа - 160154
; =============== S U B R O U T I N E =======================================
; INIT: П/п инициализации рабочей области
INIT$:	CLR	(R3)			; Очистим копию РС КНГМД
	MOV	#177777,TRKTAB(R3)	; Заполним таблицу текущих дорожек
	MOV	#177777,TRKTAB+2(R3)
	MOV	#10000,TDOWN(R3)	; Время опускания головки
	MOV	#4000,TSTEP(R3)		; Время перехода дорожки
	MOV	#12074,TRKCOR(R3)	; Дорожка начала предкомпенсации (мл.байт)
					; Число повторов при ошибке (ст.байт)
	MOV	#400,SECLEN(R3)
	CLRB	FLAGS(R3)		; Очистим флаги
	CLR	FLGTAB(R3)		;    и таблицу признаков
	CLR	FLGTAB+2(R3)
	MOV	#10.,MAXSEC(R3)		; Занесем число секторов на дорожке
	RETURN
; End of function INIT$
; End of function BOOTF$
; =============== S U B R O U T I N E =======================================
RWBLK$:	JMP	READ$			;перехват чтения-записи по номеру блока
; End of function RWBLK$
; ---------------------------------------------------------------------------
;читаем дискету
RDFLP$:	MOVB	MAXSEC(R3),R5		; число секторов на дорожке
	SWAB	R5			; делим ст. байт R0 на ст. байт R5
1$:	CMP	R5,R0
	BHI	2$
	SUB	R5,R0
	SEC
2$:	ROL	R0			; Частное накапливается в мл. байте R0
	SOB	R4,1$
	MOVB	R0,R4			; В мл. байте номер дорожки, сохраним его
	CLRB	R0
	SWAB	R0			; Получили остаток от деления
	INC	R0			; Номер сектора на единичку больше
	CLRB	SIDE(R3)		; Пока мы на нижней стороне
	CMP	R0,MAXSEC(R3)		; Этот сектор за пределами дорожки?
	BLE	3$			; Нет - полный порядок
	INCB	SIDE(R3)		; Да - значит он на другой стороне
	SUB	MAXSEC(R3),R0		;    и номер у него другой
3$:	CALL	SETPTR			; Установим указатель на байт признаков
	BITB	#2,@FLGPTR(R3)		; Диск односторонний?
	BEQ	4$			; Нет - оставим все как есть
	ASRB	SIDE(R3)		; Да - сторона всегда 0,
	ROLB	R4			;    а дорожка уже другая
4$:	MOVB	R4,TRK(R3)		; Запишем результаты: дорожка,
	MOVB	R0,SECTOR(R3)		;    сектор,
	MOV	R1,WCNT(R3)		;    число слов,
	MOV	R2,ADDR(R3)		;    адрес буфера

; SUBRW: П/п чтения-записи по номеру сектора
SUBRW:	MOV	SP,BUFSP(R3)		; Сохраняем SP,
	MFPS	BUFPSW(R3)		;    PSW,
	MOV	#4,R0
	MOV	(R0),BUF4(R3)		;    @#4 в соответствующих буферах
	MOV	PC,(R0)			; Переназначаем вектор @#4 на себя,
	ADD	#VC4ER$-.,(R0)
	TSTB	SECTOR(R3)		; Какой сектор нужен?
	BEQ	ERR$12			; Нулевых у нас нет, ошибка 12
	CMPB	SECTOR(R3),MAXSEC(R3)	; Сектор больше максимального?
	BGT	ERR$12			; Таких тоже нет, ошибка 12
	CLRB	@#ERRFDD		; Пока ошибок нет
	BICB	#30,FLAGS(R3)		; Пока не записываем
	TST	WCNT(R3)		; Сколько слов будем пересылать?
	BEQ	EX0			; 0 - ничего делать не надо, выход
	BPL	READ0			; больше 0 - будем читать
; П/п записи массива
	NEG	WCNT(R3)		; Нормализуем длину
	BISB	#20,FLAGS(R3)		; Установим признак записи
	MOV	#175641,MARKER(R3)	; Запомним маркер данных
	BITB	#1,FLAGS(R3)		; Записываем скрытно?
	BEQ	1$			; Нет - идем дальше
	MOV	#174241,MARKER(R3)	; Да - запомним специальный маркер
1$:	CALL	ENGINE			; ENGINE: Включим двигатель, запомним привод
	BIT	#4,(R4)			; Защита записи есть?
	BEQ	MAIN0			; Нет - продолжить работу
	MOV	#1,R0			; Есть - ошибка 1
	BR	ERR0$
; ---------------------------------------------------------------------------
; READ: П/п чтения массива
READ0:	CALL	ENGINE			; ENGINE: Включим двигатель, запомним привод
	MOV	#400,SECLEN(R3)		; Сектора стандартной длины
	BITB	#4,@FLGPTR(R3)		; А они ли нам нужны?
	BEQ	MAIN0			; Да - продолжить работу
	MOV	#1000,SECLEN(R3)	; Нет - сектора удвоенной длины
; MAIN: Основная часть п/п чтения/записи массива
MAIN0:	CALL	GOTRK			; GOTRK: Позиционируем на нужную дорожку
	CALL	CORR			; CORR: Включим схему предкоррекции
	MOVB	BRETRY(R3),CRETRY(R3)	; Число попыток - в буфер
; Получение заголовка сектора
	MOVB	#10,ERRNUM(R3)		; Предполагаем ошибку 10
	MOVB	#20.,TURNS(R3)		; На операцию отводим 20. оборотов
5$:	CALL	FINDH			; FINDH: Найдем маркер заголовка
	BCC	2$			; Нашли - идем дальше
3$:	MOVB	ERRNUM(R3),R0		; Не нашли - выходим с ошибкой
	BR	ERR0$
; ---------------------------------------------------------------------------
2$:	TSTB	(R4)			; Информация получена?
	BPL	2$			; Нет - подождем
	MOV	(R5),R0			; Теперь прочитаем ее
4$:	TSTB	(R4)			; Хотим еще информации!
	BPL	4$			; Дождемся ее появления
	MOV	(R5),R1			;    и заберем ее
	CALL	TSTCRC			; TSTCRC: Проверим CRC
	BNE	6$			; Ошибки нет - идем дальше
	MOVB	#2,ERRNUM(R3)		; Ошибка 2!
	DECB	CRETRY(R3)		; Остались еще попытки?
	BNE	5$			; Да - повторим чтение
	BR	3$			; Видно, не судьба! Выходим с ошибкой
; ---------------------------------------------------------------------------
6$:	BIC	#177774,R1		; Выделяем код длины сектора
	BITB	#4,@FLGPTR(R3)		; Какие сектора нам были нужны?
	BNE	LONG0			; LONG: Длинные - посмотрим...
	CMPB	R1,#2			; Короткие. А на диске какие?
	BEQ	WORK$			; WORK: Тоже короткие. Порядок, идем дальше
	DECB	CRETRY(R3)		; Как там дела с попытками?
	BNE	5$			; Есть еще - повторим все сначала
; ERR12: Выход с ошибкой
ERR$12:	MOV	#12,R0
ERR0$:	JMP	ERROR			; ERROR: Идем на обработку и выход
; ---------------------------------------------------------------------------
EX0:	JMP	EXITFL			; EXIT: Идем на нормальный выход
; ---------------------------------------------------------------------------

LONG0:	CMPB	R1,#2			; Нужны длинные сектора, а какие здесь?
					;    ОШИБКА: На самом деле код длинных секторов (1024 байта на сектор) - 3, а не 2
	BNE	ERR$12			; ERR12: Длинные - выходим с ошибкой 12

; WORK: Собственно п/п чтения
WORK$:	MOVB	BRETRY(R3),CRETRY(R3)	; Восстановим счетчик по BRETRY
	MOVB	#6,SECRET(R3)		; На поиск сектора - 6 попыток
	CLR	FREE(R3)		; Остаток сектора отсутствует
	CMP	WCNT(R3),SECLEN(R3)	; Читать нужно больше одного сектора?
	BHI	7$			; Да - идем читать
	MOV	SECLEN(R3),FREE(R3)
	SUB	WCNT(R3),FREE(R3)	; Вычислим длину остатка
7$:	MOVB	#5,ERRNUM(R3)		; Прогнозируем ошибку 5
8$:	MOVB	#20.,TURNS(R3)		; На операцию отводим 20. оборотов
9$:	CALL	FINDH			; FINDH: Ищем маркер заголовка
	BCC	10$			; Нашли - идем дальше
	MOVB	ERRNUM(R3),R0		; Кончились обороты - выходим
	BR	ERR0$			;    с ошибкой
; ---------------------------------------------------------------------------
10$:	TSTB	(R4)			; Готовность данных есть?
	BPL	10$			; Нет - подождем
	CMP	SIDE(R3),(R5)		; Нужная дорожка и сторона?
	BEQ	11$			; Да - идем дальше
	DECB	SECRET(R3)		; Минус одна попытка
	BEQ	12$			; Кончились - выход с ошибкой
	CALL	GOTO00			; GOTO00: Позиционируем на дорожку 00,
	CALL	GOTRK			; GOTRK:  вернемся на нужную
	BR	9$			;    и попытаемся еще раз
; ---------------------------------------------------------------------------
12$:	MOV	#4,R0			; Выходим с ошибкой 4
	BR	ERR0$
; ---------------------------------------------------------------------------
11$:	TSTB	(R4)			; Ждем готовности данных
	BPL	11$			; Не готовы - повторять...
	MOV	(R5),R1			; Получим номер сектора
	SWAB	R1			;    поместим его в младший байт
	CMPB	SECTOR(R3),R1		; Этот сектор ищем?
	BEQ	13$			; Да - будем его читать
	MOV	SECLEN(R3),R0		; Нет - возьмем длину данных,
	ADD	#27,R0			;    прибавим длину заголовка !!! Оп! Для режима HD тут может быть другое число
	CALL	FICT			; FICT:   и пропустим их
	BR	9$			; Повторим процедуру еще раз
; ---------------------------------------------------------------------------
13$:	CALL	TSTCRC			; TSTCRC: Проверим CRC
	BNE	14$			; Совпала - идем дальше
	MOVB	#2,ERRNUM(R3)		; Если что, это будет ошибка 2
	DECB	CRETRY(R3)		; Одной попыткой меньше
	BNE	8$			; Еще остались - поищем снова
	MOVB	ERRNUM(R3),R0		; Нет - выходим с ошибкой !!! если что, тут можно сэкономить 2 слова
	BR	ERROR
; ---------------------------------------------------------------------------
14$:	MOV	SECLEN(R3),R1		; Получим длину сектора
	SUB	FREE(R3),R1		; Вычислим длину используемой части
; Чтение сектора
	BITB	#20,FLAGS(R3)		; Будем записывать?
	BEQ	15$			; Нет - значит, читать
	JMP	WRSEC			; Да - идем на запись сектора
; ---------------------------------------------------------------------------
15$:	CALL	FINDS			; FINDS: Ищем зону синхронизации
	TSTB	SECRET(R3)		; Нашли?
	BEQ	16$			; Нет - пробуем снова
	CALL	STREAD			; STREAD: Начинаем чтение!
	MOV	#1130,R0		; !!! Оп! Для режима HD тут может быть другое число
18$:	TSTB	(R4)			; Данные готовы?
	BMI	17$			; Да - посмотрим их
	SOB	R0,18$			; Больше ждать нельзя?
16$:	MOVB	#11,ERRNUM(R3)		; Да - прогнозируем ошибку 11
	DECB	CRETRY(R3)		; Одной попыткой меньше
	BNE	8$			; Попытки есть - повторим операцию
	MOVB	ERRNUM(R3),R0		; Кончились - выйдем с ошибкой  !!! если что, тут можно сэкономить 2 слова
	BR	ERROR
; ---------------------------------------------------------------------------
17$:	TST	(R5)			; Пропустим маркер A1A1
19$:	TSTB	(R4)			; Готовность данных есть?
	BPL	19$			; Нет - ждем
	MOV	(R5),R0			; Прочитаем данные
	CMP	#120773,R0		; Обычный сектор?
	BEQ	20$			; Да - идем дальше
	CMP	#120770,R0		; Скрытый сектор?
	BNE	16$			; Что-то иное - ошибка
	BITB	#1,FLAGS(R3)		; Можно читать скрытые данные?
	BNE	20$			; Да - будем читать
	MOV	#13,R0			; Нельзя - выходим с ошибкой 13
	BR	ERROR
; ---------------------------------------------------------------------------
20$:	CALL	RDSEC			; RDSEC: Прочитаем сектор
	CALL	TSTCRC			; TSTCRC: Проверим CRC
	BNE	NEXT			; Совпала - посмотрим следующий сектор
	MOVB	#1,ERRNUM(R3)		; Не совпала - ошибка 1
	DECB	CRETRY(R3)		; Попытки кончились?
	BNE	8$			; Нет - попробуем еще раз
	MOVB	ERRNUM(R3),R0		; Кончились - выходим с ошибкой
	BR	ERROR
; ---------------------------------------------------------------------------
; Мультисекторные операции
NEXT:	SUB	SECLEN(R3),WCNT(R3)	; Сектор обработали, вычтем из длины
	BLE	EXITFL			; Массив кончился - выход
	INCB	SECTOR(R3)		; Нет - следующий сектор
	CMPB	SECTOR(R3),MAXSEC(R3)	; Конец дорожки?
	BLOS	22$			; Нет - продолжим обработку
	BIT	#40,(R3)		; Верхняя сторона?
	BNE	23$			; Да - следующая дорожка
	BITB	#2,@FLGPTR(R3)		; Диск односторонний?
	BNE	23$			; Да - продолжим обработку
	MOVB	#1,SIDE(R3)		; Нет - установим верхнюю сторону
	BIS	#40,(R3)
	BR	24$			; Перейдем к обработке
; ---------------------------------------------------------------------------
23$:	INCB	TRK(R3)			; Следующая дорожка
	CALL	GOTRK			; Позиционируем на нее
	CLRB	SIDE(R3)		; Установим нижнюю сторону
	BIC	#40,(R3)
24$:	MOVB	#1,SECTOR(R3)		; Теперь сектор будет первым
	CALL	CORR			; Переключить предкоррекцию
22$:	ADD	SECLEN(R3),ADDR(R3)	; Получим новый начальный адрес MOV  SECLEN(R3),-(SP)
	ADD	SECLEN(R3),ADDR(R3)	;                               ASL  (SP)
				        ;                               ADD    (SP)+,ADDR(R3)
					; !!! так экономим слово за счёт быстродействия
	JMP	WORK$			; WORK: Идем на чтение очередного сектора
; ---------------------------------------------------------------------------
; Обработка прерывания по вектору 4
VC4ER$:	TST	(R5)			; Сбросить данные
	MOV	#7,R0			; Заносим код ошибки 7
; ERROR: Выход с ошибкой
ERROR:	MOVB	R0,@#ERRFDD		; Код ошибки - на место!
	MOVB	#1,SECRET(R3)		; Установим бит C в буфере
	BR	EXIT1			; EXIT1: Идем на выход
; ---------------------------------------------------------------------------
; EXIT: Выход без ошибки
EXITFL:	CLRB	SECRET(R3)		; Сбросим бит C в буфере
EXIT1:	MOV	BUF4(R3),@#4		; Восстановить вектор 4
	MTPS	BUFPSW(R3)		; Восстановить PSW
	CCC				; Сбросить все признаки
	RORB	SECRET(R3)		; Бит C - из буфера в PSW
	MOV	BUFSP(R3),SP		; Восстановить SP
	RETURN
; =============== S U B R O U T I N E =======================================
; TSTCRC: П/п проверки CRC
TSTCRC:	TSTB	(R4)			; Ждем готовности данных
	BPL	TSTCRC
	MOV	#15.,R2			; CRC появится не позже 15. циклов !!! Оп! Для режима HD тут может быть другое число
1$:	BIT	#40000,(R4)		; CRC сошлась?
	BNE	2$			; Да - выход
	SOB	R2,1$			; Нет - очередной цикл
2$:	RETURN
; End of function TSTCRC
; =============== S U B R O U T I N E =======================================
; RDSEC: П/п чтения сектора в буфер; R1 - число слов для пересылки
RDSEC:	MTPS	#340			; Маскируем прерывания
	MOV	ADDR(R3),R2		; Получим адрес буфера
1$:	TSTB	(R4)			; Ожидаем данные
	BPL	1$
	MOV	(R5),R0			; Читаем два байта,
	SWAB	R0			;    делаем из них нормальное слово,
	MOV	R0,(R2)+		;    которое помещаем в буфер
	SOB	R1,1$			; Читаем заказанное число слов
	MOV	FREE(R3),R1		; Получаем длину остатка
	BEQ	2$			; Остатка нет - сразу выходим
3$:	TSTB	(R4)			; Ждем данные
	BPL	3$
	TST	(R5)			; Вхолостую читаем остаток
	SOB	R1,3$			;    требуемой длины
	MTPS	BUFPSW(R3)		; Восстанавливаем PSW
2$:	RETURN
; End of function RDSEC
; =============== S U B R O U T I N E =======================================
; FINDS: П/п поиска синхропоследовательности
FINDS:	TST	(R5)			; Сбрасываем прочитанное значение
	MOVB	#100.,SECRET(R3)	; Будем искать 100. циклов
1$:	TSTB	(R4)			; Ждем готовности
	BPL	1$
	MOV	(R5),R0			; Получим прочитанные данные
	BEQ	2$			; Это 0 - на выход
	INC	R0			; Это 177777?
	BEQ	2$			; Да - на выход
	DECB	SECRET(R3)		; Циклы кончились?
	BNE	1$			; Нет - повторяем поиск
2$:	RETURN
; End of function FINDS
; ---------------------------------------------------------------------------
; П/п чтения двух слов (не используется)
RD2W$:	TSTB	(R4)			; Ждем готовности
	BPL	RD2W$
	MOV	(R5),R0			; Получаем первое слово
1$:	TSTB	(R4)			; Ждем готовности
	BPL	1$
	MOV	(R5),R1			; Получаем второе слово
	RETURN
; =============== S U B R O U T I N E =======================================
; STREAD: П/п запуска чтения
STREAD:	BIS	#400,(R3)		; Установим признак "начало чтения"
	MOV	(R3),(R4)		;    и запишем в регистр
	BIC	#400,(R3)		; Снимем признак
	MOV	#10,R0
	SOB	R0,.			; Небольшая задержка...
	MOV	(R3),(R4)		;    и снова запишем в регистр
	RETURN
; End of function STREAD
; ---------------------------------------------------------------------------
; П/п поиска начала индекса (не используется)
FIDXB$:	TST	(R4)			; Индекс есть?
	BMI	FIDXB$			; Да - ждем исчезновения
	BIS	#400,(R3)		; Установим признак "начало чтения"
	MOV	(R3),(R4)		;    и запишем в регистр
1$:	TST	(R4)			; Индекса еще нет?
	BPL	1$			; Да - ждать появления
	MOV	HOLTIN(R3),R0
	SOB	R0,.			; Задержимся...
	BIC	#400,(R3)		; Сбросим признак "начало чтения"
	MOV	(R3),(R4)		;    и запишем в регистр
	RETURN
; =============== S U B R O U T I N E =======================================
; FINDH: П/п поиска адресного маркера
FINDH:	MOV	#15.,R0			; !!! Оп! Для режима HD тут может быть другое число
1$:	TST	(R5)			; Вхолостую прочитаем
	SOB	R0,1$			;    15. слов
	CLR	INTIME(R3)		; Начинаем ожидание индекса
	BICB	#40,FLAGS(R3)		; Пока индекса нет
2$:	BITB	#10,@FLGPTR(R3)		; Сектор задан задержкой?
	BEQ	3$			; Нет - обрабатывать
	CMPB	SECTOR(R3),#1		; Да - нужен первый сектор?
	BNE	3$			; Второй и далее задаются заголовками
	BIS	#400,(R3)		; Установим признак начало чтения
	MOV	(R3),(R4)		;    и перешлем в регистр
4$:	TST	(R4)			; Индекс есть?
	BMI	4$			; Да - ждем исчезновения
5$:	TST	(R4)			; Индекс есть?
	BPL	5$			; Нет - ждем появления
	DECB	TURNS(R3)		; Один оборот окончен
	BNE	6$			; Не кончились - продолжаем
	SEC				; Кончились - выходим с битом C
	BR	7$
; ---------------------------------------------------------------------------
6$:	MOV	HOLTIN(R3),R0		; Получим задержку после индекса
	SOB	R0,.
	BR	8$			; Сектор, похоже, найден, идем дальше
; ---------------------------------------------------------------------------
3$:	CALL	INDEX			; INDEX: Проверим наличие диска и обороты
	BCS	7$			; Обороты кончились - выходим
	BEQ	3$			; Какие данные? Нули пропустим
	COM	R0			; 177777?
	BEQ	3$			; Да - тоже пропустим
9$:	CALL	INDEX			; INDEX: Проверим наличие диска и обороты
	BCS	7$			; Обороты кончились - выходим
	BEQ	10$			; Какие данные? Нули - синхро
	COM	R0			; 177777?
	BNE	9$			; Нет - пропустим
; Проверка адресного маркера
10$:	MOV	#3,R1
11$:	MOV	(R5),R0			; Читаем данные
	BEQ	12$			; Нули - продолжаем
	COM	R0			; 177777?
	BNE	3$			; Нет - повторяем поиск
12$:	SOB	R1,11$			; Да - повторяем 3 раза
8$:	CALL	STREAD			; STREAD: Запускаем на чтение
	MOV	#1000,R0		; ОШИБКА! Здесь должно быть 2000, таки наверное не ошибка, 
					; раз у всех все работает и в СМК решили не исправлять
13$:	TSTB	(R4)			; Готовность есть?
	BMI	14$			; Есть - считываем данные
	SOB	R0,13$			; Нет - ждем
	BR	2$			; Надоело ждать - повторяем поиск
; ---------------------------------------------------------------------------
14$:	TST	(R5)			; Пропускаем A1A1
15$:	TSTB	(R4)			; Ждем готовности
	BPL	15$
	MOV	(R5),R0			; Есть - берем данные
	CMP	#120776,R0		; Адресный маркер (A1FE)?
	BEQ	16$			; Да - нормальный выход
	CMP	#120773,R0		; Нет - маркер данных (A1FB)?
	BEQ	17$			; Да - пропускаем сектор
	CMP	#120770,R0		; Нет - маркер скрытых данных (A1F8)?
	BNE	2$			; Нет - повторяем поиск сначала
17$:	CALL	FRESEC			; FRESEC: Да - пропускаем сектор
	BR	2$
; ---------------------------------------------------------------------------
16$:	CLC
7$:	RETURN
; End of function FINDH
; =============== S U B R O U T I N E =======================================
; INDEX: П/п проверки диска и числа оборотов
INDEX:	TST	(R4)			; Индекс есть?
	BPL	1$			; Нет - идем проверять
	BITB	#40,FLAGS(R3)		; Индекс есть - он уже был?
	BNE	2$			; Был - идем увеличивать время
	CLR	INTIME(R3)		; Только что появился - очистим время
	BISB	#40,FLAGS(R3)		;    и запомним факт появления
	DECB	TURNS(R3)		; Закончился последний оборот?
	BNE	3$			; Нет - нормальный выход
	SEC				; Да - выход с ошибкой
	RETURN
; ---------------------------------------------------------------------------
3$:	CLC
	MOV	(R5),R0			; Забираем данные
	RETURN
; ---------------------------------------------------------------------------
1$:	BITB	#40,FLAGS(R3)		; Индекса нет - а он был?
	BEQ	2$			; Нет и не было - идем считать время
	CLR	INTIME(R3)		; Только что исчез - очистим время
	BICB	#40,FLAGS(R3)		;    и запомним факт исчезновения
	BR	3$			; Нормально выходим
; ---------------------------------------------------------------------------
2$:	INC	INTIME(R3)		; Еще один такт индекс не менялся
	CMP	INTIME(R3),#60000	; Ну сколько можно! Пора кончать?
	BLOS	3$			; Не пора - нормальный выход
	MOV	#6,R0			; Терпение кончилось -
	JMP	ERROR			; ERROR:   значит диска нет - ошибка 6
; End of function INDEX
; =============== S U B R O U T I N E =======================================
; ENGINE: П/п выбора устройства
ENGINE:	MOV	#177130,R4		; Заполняем рабочие регистры
	MOV	R4,R5			;    адресами PC
	TST	(R5)+			;    РД КНГМД
	BICB	#4,FLAGS(R3)		; Очистим признак работы двигателя
	BIT	#20,(R3)		; Двигатель уже включен?
	BEQ	1$			; Нет - включим
	BISB	#4,FLAGS(R3)		; Да - установим признак
1$:	BIS	#20,(R3)		; Включим двигатель
	MOV	(R3),(R4)		;    и запишем в регистр
	BIC	#57,(R3)		; Сбросим все другие режимы
	TSTB	SIDE(R3)		; Сторона верхняя?
	BEQ	2$			; Да - идем дальше
	BIS	#40,(R3)		; Нет - включим нижнюю
2$:	BICB	#177774,UNIT(R3)	; Сбросим лишние биты
	MOVB	UNIT(R3),R1		; Получим номер привода
	MOV	PC,R0			; Получим базовый адрес
	ADD	#DRMAS$-.,R0		;    таблицы масок для приводов
	ADD	R1,R0			; Получим адрес нужной маски
	BISB	(R0),(R3)		; Установим бит нужного привода
	ADD	R3,R1			; Получим базовый адрес
	ADD	#TRKTAB,R1		;    таблицы TRKTAB
	MOV	R1,CURTRK(R3)		; Настроим указатель CURTRK
	CALL	SETPTR			; SETPTR: Настроим указатель FLGPTR
	BITB	#4,FLAGS(R3)		; Мотор включен только что?
	BNE	3$			; Нет - выходим
	CLR	R1			; Да - подождем раскручивания
	SOB	R1,.
	SOB	R1,.
3$:	MOV	(R3),(R4)		; Записываем установки в регистр
	MOV	TDOWN(R3),R1		; Подождем опускания головки
	SOB	R1,.
	RETURN
; End of function ENGINE
; ---------------------------------------------------------------------------
; Таблица масок для включения приводов
DRMAS$:	.BYTE 1				;A
	.BYTE 2				;B
	.BYTE 1				;A (C и далее - уже винт)
	.BYTE 2				;B
; =============== S U B R O U T I N E =======================================
; SETPTR: П/П настройки указателя FLGPTR
SETPTR:	CLR	FLGPTR(R3)		; Очистим указатель FLGPTR
	BICB	#177774,UNIT(R3)	; Отбросим лишние биты
	MOVB	UNIT(R3),FLGPTR(R3)	; Перешлем номер привода в FLGPTR
	ADD	R3,FLGPTR(R3)		; Прибавляя базовый адрес FLGTAB
	ADD	#FLGTAB,FLGPTR(R3)	;    получаем искомый адрес
	RETURN
; End of function SETPTR
; =============== S U B R O U T I N E =======================================
; GOTRK: П/п позиционирования
GOTRK:	TSTB	TRK(R3)			; Нужна дорожка 00?
	BEQ	GOTO00			; Да - позиционируем прямо на нее
	TSTB	@CURTRK(R3)		; Положение головки известно?
	BPL	1$			; Да - будем искать требуемую
	CALL	GOTO00			; Нет - придется сориентироваться
1$:	CMPB	@CURTRK(R3),TRK(R3)	; Нужная дорожка совпадает с текущей?
	BEQ	2$			; Да - так что же мы тут делаем?
	BHI	3$			; Нет - искомая ближе к центру?
	CALL	GOUP			; Да - шагаем к центру
	BR	1$			; Проверим, дошли ли
; ---------------------------------------------------------------------------
3$:	CALL	GODOWN			; Нет - шагнем к периферии
	BR	1$			; Проверим, дошли ли
; ---------------------------------------------------------------------------
2$:	MOV	#10000.,R0		; Подождем успокоения головки
	SOB	R0,.			; Теперь можно и выйти
	RETURN
; End of function GOTRK
; =============== S U B R O U T I N E =======================================
; GOUP: Шаг к центру
GOUP:	INCB	@CURTRK(R3)		; Номер дорожки станет на 1 больше
	BMI	1$			; Таких дорожек нет - выходим с ошибкой
	BIS	#100,(R3)		; Все в порядке - шагать будем вперед
	BR	STEP$			; Пойдем шагать
; ---------------------------------------------------------------------------
1$:	MOV	#4,R0			; Выход с ошибкой 4
	JMP	ERROR
; End of function GOUP
; =============== S U B R O U T I N E =======================================
; GODOWN: Шаг к периферии
GODOWN:	DECB	@CURTRK(R3)		; Номер дорожки станет на 1 меньше
	BIT	#1,(R4)			; Дошли до дорожки 00?
	BEQ	1$			; Нет - можно шагать
	CLRB	@CURTRK(R3)		; Дошли: теперь текущая - 00
	RETURN				;    и можно выйти
; ---------------------------------------------------------------------------
1$:	BIC	#100,(R3)		; Шагать будем назад
STEP$:	MOV	#310,R0			; Подготовим задержку
	MOV	(R3),(R4)		; Перешлем направление шага в регистр
	SOB	R0,.			; Подождем, пока контроллер "переварит"
	BIS	#200,(R3)		; Установим признак шага
	MOV	(R3),(R4)		;    и запишем в регистр
	MOV	TSTEP(R3),R0		; Получим задержку перехода дорожки
	SOB	R0,.			;    и задержимся
	BITB	#1,@FLGPTR(R3)		; Двойной шаг?
	BEQ	1$			; Нет - можно выходить
	BITB	#100,FLAGS(R3)		; Мы возвращаемся на 00?
	BNE	1$			; Да - возвращаться надо одинарным шагом
	MOV	(R3),(R4)		; Нет - придется шагнуть еще
	MOV	TSTEP(R3),R0		; Получим задержку перехода дорожки
	SOB	R0,.			;    и задержимся
1$:	BIC	#200,(R3)		; Очистим признак шага
	RETURN
; End of function GODOWN
; =============== S U B R O U T I N E =======================================
; GOTO00: П/п возврата на дорожку 00
GOTO00:	MOVB	#200,@CURTRK(R3)	; Установим счетчик дорожек
	BISB	#100,FLAGS(R3)		; Возвращаться надо одинарным шагом
1$:	CALL	GODOWN			; GODOWN: Шагнем к периферии
	BIT	#1,(R4)			; Дошли до 00?
	BNE	2$			; Да - выходим
	TSTB	@CURTRK(R3)		; На какой дорожке должны находиться?
	BNE	1$			; Не на нулевой - еще шагнем
	MOV	#3,R0			; На нулевой, а ее нет - ошибка 3
	BICB	#100,FLAGS(R3)		; Сбросим режим одинарного шага
	JMP	ERROR			; Выходим с ошибкой
; ---------------------------------------------------------------------------
2$:	CLRB	@CURTRK(R3)		; Дошли - текущая теперь нулевая
	BICB	#100,FLAGS(R3)		; Сбросим режим одинарного шага
	RETURN
; End of function GOTO00
; =============== S U B R O U T I N E =======================================
; FRESEC: П/п пропуска сектора
FRESEC:	MOV	SECLEN(R3),R0		; Получим длину сектора
; =============== S U B R O U T I N E =======================================
; FICT: П/п фиктивного чтения
FICT:	TST	(R4)			; Индекс есть?
	BMI	1$			; Да - ждем начала оборота
2$:	TST	(R4)			; Индекс все еще есть?
	BMI	3$			; Да - оборот завершен
4$:	TSTB	(R4)			; Данные готовы?
	BPL	2$			; Нет - снова
	TST	(R5)			; Прочитаем данные вхолостую
	SOB	R0,2$			;    требуемое число раз
	BR	5$			;    и выйдем
; ---------------------------------------------------------------------------
3$:	DECB	TURNS(R3)		; Все обороты вышли?
	BNE	6$			; Нет - попытаемся снова
	MOV	#5,R0			; Да - выходим с ошибкой 5
	JMP	ERROR
; ---------------------------------------------------------------------------
1$:	TST	(R4)			; Индекс исчез?
	BPL	4$			; Да - оборот начался
6$:	TSTB	(R4)			; Данные готовы?
	BPL	1$			; Нет - проверим индекс
	TST	(R5)			; Прочитаем данные вхолостую
	SOB	R0,1$			;    требуемое число раз
5$:	RETURN				;    и вернемся к основной работе
; End of function FICT
; End of function FRESEC
; ---------------------------------------------------------------------------
; WRSEC: П/п записи сектора
; Входные параметры: R1 - число слов для записи
WRSEC:	MOV	ADDR(R3),R2		; Получим начальный адрес массива
	MOV	#11.,R0			; В маркере будет 11. 4E4E
	MTPS	#340			; При записи нам не мешать!
	CALL	WRMAR			; Запишем маркер данных
1$:	TSTB	(R4)			; Готовность есть?
	BPL	1$			; Нет - ждем
	MOV	(R2)+,(R5)		; Запишем первое слово данных
	MOV	(R3),(R4)		; Снимем признак записи маркера
	BR	2$			;    и пойдем записывать данные
; ---------------------------------------------------------------------------
3$:	TSTB	(R4)			; Готовность есть?
	BPL	3$			; Нет - дождемся
	MOV	(R2)+,(R5)		; Запишем слово данных
2$:	SOB	R1,3$			;    и так до конца
	MOV	FREE(R3),R1		; Получим длину пустого остатка сектора
	BEQ	4$			; Остатка нет - выходим сразу
5$:	TSTB	(R4)			; Готовность есть?
	BPL	5$			; Дожидаемся
	MOV	#0,(R5)			; Записываем нули
	SOB	R1,5$			;    в нужном количестве
4$:	BIT	#40000,(R4)		; Ждем записи CRC
	BEQ	4$
	MOV	#47116,(R5)		; Записываем 4E4E
6$:	TSTB	(R4)			; Готовность есть?
	BPL	6$			; Нет - ждем
	TST	(R5)			; Прекращаем запись
	MTPS	BUFPSW(R3)		; Восстанавливаем PSW
	JMP	NEXT			; NEXT: Продолжаем запись массива

; =============== S U B R O U T I N E =======================================
; WRMAR: П/п записи маркера данных
; Входные данные: R0 - число записываемых слов 4E4E
WRMAR:	MOV	#47116,(R5)		; Запишем 4E4E
	BR	2$			; Идем на повтор записи
; ---------------------------------------------------------------------------
1$:	TSTB	(R4)			; Готовность есть?
	BPL	1$			; Нет - дождемся
	MOV	#47116,(R5)		; Запишем 4E4E
2$:	SOB	R0,1$			; Повторим заданное число раз
	MOV	#6,R0			; Запишем 12. нулевых байтов
3$:	TSTB	(R4)			; Готовность есть?
	BPL	3$			; Нет - ожидаем
	MOV	#0,(R5)			; Записываем нули
	SOB	R0,3$			;    в нужном количестве
	BIS	#1000,(R3)		; Подготовим признак записи маркера
4$:	TSTB	(R4)			; Контроллер готов?
	BPL	4$			; Нет - ждем
	MOV	#120641,(R5)		; Записываем маркер A1A1
	MOV	(R3),(R4)		; Передаем признак в контроллер
	BIC	#1000,(R3)		; Заранее снимем признак
5$:	TSTB	(R4)			; Готовность есть?
	BPL	5$			; Нет - ожидаем
	MOV	MARKER(R3),(R5)		; Записываем маркер из буфера
	RETURN
; End of function WRMAR
; =============== S U B R O U T I N E =======================================
; CORR: П/п установки прекоррекции
CORR:	BIC	#2000,(R3)		; Снимем прекоррекцию
	CMPB	TRKCOR(R3),@CURTRK(R3)	; Надо включать на текущей дорожке?
	BHI	1$			; Нет - пропустим
	BIS	#2000,(R3)		; Пора - включим
1$:	MOV	(R3),(R4)		; Перешлем управляющее слово
	MOV	#200.,R0		; !!! задержка включения прекоррекции
	SOB	R0,.			; Подождем, пока контроллер воспримет
	RETURN
; End of function CORR
; ---------------------------------------------------------------------------
; FORMAT: П/п форматирования
FORMT$:	JMP	FORM$			;перехват форматирования
; ---------------------------------------------------------------------------
FORMFL:	MFPS	BUFPSW(R3)
	MOV	#4,R0
	MOV	(R0),BUF4(R3)		; Сохраним @#4 в соответствующих буферах
	MOV	PC,(R0)			; Переназначаем вектор @#4 на себя
	ADD	#VC4ER$-.,(R0)
	CALL	ENGINE			; Запустим двигатель
	CALL	GOTRK			; Позиционируем на нужную дорожку
	CALL	CORR			; Установим прекоррекцию
	BIT	#4,(R4)			; Защита записи включена?
	BEQ	L1$			; Нет - начинаем форматировать
	MOV	#1,R0			; Да - ошибка 1
ER0:	JMP	ERROR			; Выходим с ошибкой
; ---------------------------------------------------------------------------
L1$:	SWAB	SIDE(R3)		; Обмениваем номера стороны и дорожки
	MOVB	FILLB(R3),WRTVAR(R3)	; Делаем слово-заполнитель
	MOVB	FILLB(R3),WRTVAR+1(R3)	;    из байта-заполнителя
	MOVB	MAXSEC(R3),R1		; Получим длину сектора
	MOV	#1001,R2		; Запомним номер сектора и код длины
	MOV	#1750,R0		; Время ожидания индекса !!! Оп! Для режима HD тут может быть другое число
2$:	TST	(R4)			; Индекс есть?
	BPL	3$			; Исчез - начинаем записывать
	SOB	R0,2$			; Есть - ждем исчезновения
4$:	TST	(R5)			; Так и не исчез - прекратим запись
	MOV	#6,R0			; Диск не вращается - ошибка 6
	SWAB	SIDE(R3)		; Вернем все на место
	BR	ER0			; Выходим с ошибкой
; ---------------------------------------------------------------------------
; Запись на дорожку кода 4E4E
3$:	MOV	#6200,R0		; Установим максимальную длину !!! Оп! Для режима HD тут может быть другое число
	MTPS	#340			; При записи нам не мешать
	MOV	#47116,(R5)		; Записываем 4E4E
5$:	TST	(R4)			; Индекс появился?
	BMI	6$			; Да - начинаем запись
7$:	TSTB	(R4)			; Готовность есть?
	BPL	7$			; Нет - ждем
	MOV	#47116,(R5)		; Записываем 4E4E
	SOB	R0,5$			; И так до конца дорожки
	BR	4$			; Дорожка длинная, ошибка!
; ---------------------------------------------------------------------------
6$:	MOV	#20,R0			; В маркере будет 16. 4E4E (GAP1) !!! Оп! Для режима HD тут может быть другое число
	MOV	#177241,MARKER(R3)	; Адресный маркер (FEA1) - в буфер
8$:	CALL	WRMAR			; WRMAR: Записываем адресный маркер
9$:	TSTB	(R4)			; Готовность есть?
	BPL	9$			; Нет - ожидаем
	MOV	SIDE(R3),(R5)		; Записываем номер стороны и дорожки
	MOV	(R3),(R4)		; Перешлем управляющее слово
10$:	TSTB	(R4)			; Готовность есть?
	BPL	10$			; Нет - дождемся
	MOV	R2,(R5)			; Записываем номер сектора и код длины
	MOV	#11.,R0			; В маркере будет 11. 4E4E (GAP2) !!! Оп! Для режима HD тут может быть другое число
	MOV	#175641,MARKER(R3)	; Маркер данных (FBA1) - в буфер
11$:	BIT	#40000,(R4)		; Ждем записи CRC
	BEQ	11$
	CALL	WRMAR			; WRMAR: Записываем маркер данных
	MOV	SECLEN(R3),R0		; Получаем длину сектора
	DEC	R0			; Одно слово запишем сейчас
12$:	TSTB	(R4)			; Готовность есть?
	BPL	12$			; Нет - ожидаем
	MOV	WRTVAR(R3),(R5)		; Записываем заполнитель
	MOV	(R3),(R4)		; Перешлем управляющее слово
13$:	TSTB	(R4)			; Готовность есть?
	BPL	13$			; Нет - дождемся
	MOV	WRTVAR(R3),(R5)		; Записываем заполнитель
	SOB	R0,13$			; И так до конца сектора
	INC	R2			; Увеличим номер сектора
	MOV	#21.,R0			; В маркере будет 21. 4E4E (GAP3) !!! Оп! Для режима HD тут может быть другое число

;    Примечание. Если увеличить GAP3 до 24-27 слов, то запись будет производиться так
; же быстро, как и чтение (обычно заголовок очередного сектора проскакивает, и дорожка
; записывается не за один, а за 10 оборотов). Однако при превышении этой величиной
; определенного значения конец последнего сектора дорожки может наложиться на ее
; же начало.

	BIT	#4,@FLGPTR(R3)		; Сектора длинные?
	BEQ	14$			; Нет - все нормально
	MOV	#75,R0			; Да - будет 122. 4E4E
14$:	MOV	#177241,MARKER(R3)	; Адресный маркер (FEA1) - в буфер
15$:	BIT	#40000,(R4)		; Ждем записи CRC
	BEQ	15$
	SOB	R1,8$			; И так все сектора до конца дорожки
; Окончание записи дорожки
16$:	TSTB	(R4)			; Готовность есть?
	BPL	16$			; Нет - ждем
	MOV	#47116,(R5)		; Запишем 4E4E
	TST	(R4)			; Индекс есть?
	BPL	16$			; Нет - продолжим запись до появления
17$:	TSTB	(R4)			; Готовность есть?
	BPL	17$			; Нет - дождемся
	MOV	#47116,(R5)		; Запишем 4E4E
	TST	(R5)			; Прекратим запись
	MTPS	BUFPSW(R3)		; Восстановим PSW
	SWAB	SIDE(R3)		; Вернем все на место
	JMP	EXITFL			; Выходим

; блок работы с HDD, адрес начала 164022, следить строго---------------------

.IIF GT	.-164022	.ERROR	; Перекрытие кода !!!

;		 v2.05	???
;17.9.96 v1.41	испр.ош. v1.40 и ->CALL RDY2 перед I/O HDD
;21.6.96 v1.40	 врем.для SMK: на 6 МГц при ПЗП не чувств.клав.
;16.6.95 v1.33	- была ошибка им.Коренкова с перех.на лок.метку
;16.2.96 v1.35	;запорка: если добиться обращения по 160006 при
		;плохой Part&Config и неготовом винте: ->SETPRM
		;(при загрузке Part. чит.всегда, если в. готов)
;.LA 164022	;переходы BR-> EX11-> EX1 на грани
. =  164022	;строки, отлич.для БК10 помеч. "10!"
;Адрес перезапуска =@167716=167400 = #ZAG-2 нельзя смещать !!!
;Для краткости особый вызов BOOT$ с сопрограммой.
;Сообщ. "(с)" тк при V30=100112

FORM$:				;точка входа по 160012
	MOV	SP,BUFSP(R3)
	CLRB	ERRNUM(R3)
	JSR	R4,USER$
	.WORD	4
	CALL	(R5)
	BR	EX12
2$:	JMP	FORMFL
; ---------------------------------------------------------------------------
	CMPB	UNIT(R3),#2
	BLO	2$
	MOV	@#HD$SEC,R0	;секторов на дор.
	MOVB	#1,SECTOR(R3)
	MOV	R0,FREE(R3)	;призн.вериф., >0
	SWAB	R0
	MOV	R0,WCNT(R3)	;длина, слов
	JMP	ALL

; =============== S U B R O U T I N E =======================================
BOOT$:				;точка входа по загрузке, перехват 160072 (10!)
	CALL	@(SP)+		;CALL 160156: -1 слов ;10!
	CLR	@#HD$OZU	;0 - конец цепи
	MOV	#HD$USR,R2
	MOV	PC,(R2)
	MOV	PC,-(R2)	;HD$EIS
	MOV	PC,-(R2)	;HD$US1
	SXT	@#R$HEAD
	CLR	@#R$SRES	;сброс
	MOV	#6,@#R$SRES
	MOVB	#6,@#ERRFDD
	MOVB	R0,UNIT(R3)	;<0 тк 1-й по умолч.
	BPL	3$
	CALL	RDY4		;7.4 sec max
3$:	TST	R0
	BMI	6$		;#0,1 по умолч.(ст.байт	< 0)
	CALL	RDY2		;3.7 sec max
	BCC	7$
				;винта нет или неиспр.
	CMPB	R0,#2		;# LOG
	BHIS	5$
6$:	CLR	R0		;Читаем нулевой блок ;10!
	JMP	FLPLOD		;там R0 не исп. 10!
; ---------------------------------------------------------------------------
5$:	RETURN
; ---------------------------------------------------------------------------
7$:	CALL	PARTRD		;чт.табл.разд.и счит.ее CRC
	MOVB	UNIT(R3),R0	;# привода
	BPL	1$
	MOVB	@#HD$UNI,R0	;устр.по умолчанию
	MOVB	R0,UNIT(R3)
	BEQ	5$
1$:	CMPB	R0,#2
	BLO	6$
	MOVB	#1,SECTOR(R3)	;сект.#1
	MOV	#HD$MBR,ADDR(R3)
	MOV	#3400,WCNT(R3)	;7 блоков
	CLR	SIDE(R3)	;дор.=0, гол.=0
	CALL	RWSEC		;чтение MBR (7 бл.) с 20000
	BCS	5$		;ошибка

	CMP	@#HD$MBR,#240
	BNE	4$
	CALL	@#HD$MBR	;CALL на MBR
4$:	MOVB	(PC),(R3)	;для ANDOS - не 253 прошивка
	BR	6$		;"вторичная" загрузка
; End of function BOOT$

; =============== S U B R O U T I N E =======================================
READ$:				;точка входа по 160004, перехват 160250
	MOV	#10,R4
	CLRB	ERRNUM(R3)	;на всякий случай
	JSR	R4,USER$	;проверка драйв.пользователя
	.WORD	0
	CALL	(R5)
EX12:	BR	EX11
; ---------------------------------------------------------------------------
2$:	JMP	RDFLP$		; ид#м читать дискету
; ---------------------------------------------------------------------------
	CMPB	UNIT(R3),#2
	BLO	2$
R$:	TST	R1		;WCNT
	SXT	FREE(R3)	;0 - READ, -1 - WRITE
	BPL	4$
	NEG	R1
4$:	MOV	R1,WCNT(R3)	;WCNT
	MOV	R2,ADDR(R3)	;ADDR
	CALL	CRC
	SUB	-(R1),R2
	BEQ	L11
	CALL	PARTRD		;чт.табл.разд.и CNF
	MOVB	#13,ERRNUM(R3)
EX11:	BR	EX1
; ---------------------------------------------------------------------------
L11:	BISB	UNIT(R3),R2	;#LOG, R2=0
	CMPB	#377,R2		;абс.адресация?
	BNE	9$
	MOV	#ABSLOG,R2	;можно и неперемещ!
	BR	8$
; ---------------------------------------------------------------------------
9$:	DEC	R2
	MOVB	#3,ERRNUM(R3)	;ERR 3
	CMPB	R2,@#HD$LOG
	BHI		EX1
	ASL	2
	ASL	R2
	SUB	#HD$LOG,R2	;=TOP табл.разделов
	NEG	R2		;R2-ADDR из табл.разд.

8$:	MOV	(R2)+,R4	;объем LOG
	CLRB	ERRNUM(R3)	;#ошибки
	MOV	WCNT(R3),R1	;WCNT
	BNE	6$
	CMP	R0,R4
	BLO	7$
	MOV	R4,R0
	DEC	R0		;последний блок LOG
7$:	MOV	R2,-(SP)	;координаты LOG
	MOV	ADDR(R3),R1
	BEQ	6$
	MOV	#HD$TRK,R2	;указ.на кол-во дорожек
	MOV	(R2),(R1)+	;дорожек
	MOV	-(R2),(R1)+	;головок
	MOV	-(R2),(R1)+	;секторов
	MOV	-(R2),(R1)+	;лог.дисков
	MOV	(SP),R2
	CLR	R1

6$:	ADD	#377,R1
	CLRB	R1
	SWAB	R1
	MOVB	R1,TURNS(R3)	;блоков - тут ячейки рабочей области драйвера используются по-своему
	ADD	R0,R1		;конечный блок
	BCS	5$		;перенос, R1>177777
	CMP	R1,R4		;внутри LOG ?
	BLOS	2$
5$:	MOVB	#5,ERRNUM(R3)
	CMP	R0,R4
	BHIS	EX1		;вых., т.к.нач блок вне LOG
	SUB	R0,R4		;сколько можно прочитать
	MOVB	R4,TURNS(R3)

2$:	MOV	(R2),R2		;нач.LOG
	BPL	11$
	COM	R2		;-запрет записи; TURNS(R3)
	TST	FREE(R3)	;не м.б.=0
	BMI	ERR1
11$:	MOV	R2,R1
	BIC	#177760,R1	;гол.нач.LOG
	MOV	R1,-(SP)
	BIC	R1,R2
	CLC
	ROR	R2
	ASR	R2
	ASR	R2
	ASR	R2		;дор.нач.LOG

	MOV	@#HD$SEC,R1	;секторов
	CALL	DIV$		;R0/R1->R0,|R1|
	INC	R1		;нумерация с 1
	MOVB	R1,CRETRY(R3)	;старт.сектор /SECTOR(R3)

	MOVB	@#HD$HEA,R4	;всего головок
	MOV	R4,R1
	CALL	DIV$		;R0/R1 -> R0,|R1|
	ADD	R0,R2

	ADD	R1,(SP)
	CMPB	(SP),R4
	BLO	3$
	SUB	R4,(SP)
	INC	R2		;старт.дор.
3$:	MOV	(SP)+,R0	;старт.гол.
	TSTB	TURNS(R3)
	BNE	ALL1
	ASL	R2
	ASL	R2
	ASL	R2
	ASL	R2
	BIS	R0,R2
	MOV	R2,SIDE(R3)
	MOV	(SP)+,R2
	MOV	(R2),R1		;координаты LOG
	MOV	-(R2),R0	;объем LOG
	BR	EX1
; ---------------------------------------------------------------------------
ERR1:	MOVB	#1,ERRNUM(R3)
	BR	EX1
; ---------------------------------------------------------------------------
ERR12$:	MOVB	#12,ERRNUM(R3)
EXIT:	MOV	BUFSP(R3),SP	;выход из драйвера
	MOV	BUF4(R3),@#4
EX1:	CLC
	MOVB	ERRNUM(R3),@#ERRFDD
	BEQ	1$
	SEC
1$:	MOV	#R$ERRR,R4	;для прогр, делающих MOV ..,@R4
	RETURN
; End of function READ$
; ---------------------------------------------------------------------------
STOP$:	MOVB	#7,ERRNUM(R3)
	BR	SPEX
; =============== S U B R O U T I N E =======================================
ABS$RD:				;точка входа по 160006
	CLRB	ERRNUM(R3)
	JSR	R4,USER$
	.WORD	2
	CALL	(R5)
	BR	EX1		;не оптимизировать!
1$:	JMP	SUBRW
; ---------------------------------------------------------------------------
	CMP	(SP),#CAL06	;перемещ.не важна - тк при загр
	BEQ	3$		;нужно для PARTRD при 0(1)B
	CMPB	UNIT(R3),#2
	BLO	1$
3$:	MOV	WCNT(R3),R0	;WCNT
	BEQ	EX1
	SXT	FREE(R3)	;0 - READ, -1 - WRITE
	BPL	2$
	CMPB	UNIT(R3),#377	;запись разреш. тк для UNIT=-1
	BNE	ERR1
	NEG	R0
	MOV	R0,WCNT(R3)
2$:	ADD	#377,R0

ALL:	CLRB	R0		;C=0
	BISB	SECTOR(R3),R0
	BEQ	ERR12$
	MOV	R0,CRETRY(R3)	;мл.б=#сект, ст.б= к-во сект;/SECTOR(R3)
	MOV	SIDE(R3),R0
	MOV	R0,R2
	BIC	#177760,R0	;старт.гол.
	BIC	R0,R2
	ROR	R2
	ASR	R2
	ASR	R2
	ASR	R2		;старт.дор.

;R0 - старт.гол., R2 - старт.дор., TURNS(R3) - число секторов
;CRETRY(R3) - старт.сектор, FREE(R3) - 0-чт., -1-зап., >0-вериф.
;SECTOR(R3) освобождено для возможной имитации FDD
ALL1:	MOV	#4,R4
	MOV	(R4),BUF4(R3)
	MOV	SP,BUFSP(R3)
	MOV	PC,(R4)
	ADD	#STOP$-.,(R4)
	MOV	@#HD$US1,R5	;то, что после уст. V4 - норм.
	CMP	(R5),#240
	BNE	2$
	CALL	(R5)
2$:	MOV	#R$STAT,R4
	CALL	RDY2		;меньшая задержка при перезап./дубле
	BCC	L2		;если чтение каталога не раскруч.двиг.
				;мж вызывать ош.6
	MOVB	#6,ERRNUM(R3)	;ошибка 6
SPEX:	CALL	SETPRM
EXI:	BR	EXIT
; ---------------------------------------------------------------------------
L2:	COM	R2
	MOV	R2,@#R$TRKL	;мл.б.дор.
	SWAB	R2
	MOV	R2,@#R$TRKH	;ст.б.дор.
	BISB	@#HD$DRV,R0
	COM	R0
	MOV	R0,@#R$HEAD	;гол.
	MOV	CRETRY(R3),R0	;сектор & к-во /SECTOR(R3)
	COM	R0
	MOVB	R0,@#R$SECT	;старт.сектор
	SWAB	R0
	MOVB	R0,R0		;до 128 !!!
	MOV	R0,@#R$COUN	;кол-во секторов
	MOV	#R$DATA,R5
	COM	R0
	MOV	ADDR(R3),R2	;ADDR
	MOV	#337,R1		;"Чтение"
	TST	FREE(R3)
	BEQ	4$
	BMI	5$
	SUB	#20,R1
5$:	SUB	#20,R1		;"Запись"
4$:	MOV	R1,(R4)		;запись команды
	CMP	R1,#277
	BEQ	ENDVER

;R1=337-чтение, 317-запись, 277-верификация
RDWR:	MOV	#400,R1
	CMP	R1,WCNT(R3)
	BLOS	1$
	MOV	WCNT(R3),R1
1$:	TSTB	(R4)
	BPL	1$
101$:	BIT	#10,(R4)
	BNE	101$
	CMP	@#HD$SPD,#125252
	BEQ	L7
	TST	FREE(R3)
	BMI	3$
2$:	TSTB	(R4)
	BPL	2$
	MOV	(R5),(R2)+	;RD
	SOB	R1,2$
	BR	L4$
; ---------------------------------------------------------------------------
3$:	TSTB	(R4)
	BPL	3$
	MOV	(R2)+,(R5)	;WR
	SOB	R1,3$
L4$:	BIT	#1,(R4)
	BEQ	ERR$HD
	SUB	#400,WCNT(R3)
	MOV	R2,ADDR(R3)
	SOB	R0,RDWR

	MOV	WCNT(R3),R0
	BGE	EXI
	NEG	R0
	TST	FREE(R3)
	BMI	6$
5$:	TSTB	(R4)
	BPL	5$
	TST	(R5)
	SOB	R0,5$
	BR	EXI
; ---------------------------------------------------------------------------
6$:	TSTB	(R4)
	BPL	6$
	MOV	R1,(R5)	;R1=0
	SOB	R0,6$
EXI2:	BR	EXI
; ---------------------------------------------------------------------------
L7:	TST	FREE(R3)
	BMI	9$

8$:	MOV	(R5),(R2)+	;RD
	SOB	R1,8$
	BR	L4$
; ---------------------------------------------------------------------------
9$:	MOV	(R2)+,(R5)	;WR
	SOB	R1,9$
	BR	L4$
; ---------------------------------------------------------------------------
ENDVER:	TSTB	(R4)
	BPL	ENDVER
	BIT	#1,(R4)
	BNE	EXI2

ERR$HD:	CLR	R0
	BISB	@#R$ERRR,R0
	COM	R0
	BIC	#4,R0		;устан.вместе с др.разрядами
	MOV	#ERRTAB-1,R2	;перемещ.не важна
1$:	INC	R2
	ROR	R0
	BCC	1$
	MOVB	(R2),ERRNUM(R3)
	BR	EXI2
; End of function ABS$RD
; =============== S U B R O U T I N E =======================================
USER$:				;опр.налич.USR-драйвера и возврат его адреса с
				;необх.смещ.в R5 или выход на HDD
	MOV	@#HD$USR,R5
	CMP	R5,#HD$LOG
	BHIS	1$
	CMP	(R5)+,#240
	BEQ	2$
1$:	ADD	#10,R4		;->HDD; а что будет в R5 - не важно
2$:	ADD	(R4)+,R5	;смещ.соотв.тчк входа USER
	RTS	R4
; End of function USER$
; =============== S U B R O U T I N E =======================================
DIV$:
;На входе:  R0-делимое,R1-делитель
;На выходе: R0-частное,R1-остаток
	MOV	R2,-(SP)
	MOV	R3,-(SP)
	MOV	#16.,R3
	CLR	R2
1$:	ASL	R0
	ROL	R2
	CMP	R1,R2
	BHI	2$
	SUB	R1,R2
	INC	R0
2$:	SOB	R3,1$
	MOV	R2,R1
	MOV	(SP)+,R3
	MOV	(SP)+,R2
	RETURN
; End of function DIV$
; =============== S U B R O U T I N E =======================================
CRC:				;подсчет CRC таблицы разделов
	MOV	(PC),R2		;с избытком 12701,против всех 0
	MOV	#HD$TRK+2,R1	;<если все нули, совпадет>
	MOVB	@#HD$LOG,R5	;до 128 !
	BMI	RTS1
	TST	(R5)+		;=ADD #2
1$:	ADD	-(R1),R2
	ADD	-(R1),R2
	SOB	R5,1$
RTS1:	RETURN
; End of function CRC
; =============== S U B R O U T I N E =======================================
PARTRD:				;чт.CNF, табл.разд.и подсч.CRC
	MOV	#8.,R4		;именно >7, т.к. м.б. сразу SETPRM
	MOV	#HD$HEA,R0
	MOV	R4,(R0)		;= мастер!
	MOV	R4,-(R0)	;HD$SEC
	CLR	-(R0)		;HD$LOG
	MOVB	R4,SECTOR(R3)	;#сект.=8
	MOV	#HD$SPD,ADDR(R3);176000
	MOV	#400,WCNT(R3)	;блок
	CLR	SIDE(R3)	;дор.=0, гол.=0
	CALL	RWSEC		;partition &config; будет обра-
CAL06:	BCS	RTS1		;HDD-x	;ботан при любом UNIT(R3)
	MOV	#R$STAT,R4
	CALL	CRC
	CMP	R2,-(R1)	;CRC
	BEQ	SETPRM

	CALL	RDY		;1.7sec, BCS не бывает?
	MOV	#R$DATA,R5	;из 160006, испорчено by CRC
	MOV	#23,(R4)	;"IDENTIFY"
101$:	TSTB	(R4)
	BPL	101$
102$:	BIT	#10,(R4)	;R4=R$STAT
	BNE	102$
	MOV	#HD$TRK+2,R2
	MOV	#512,R1		;^B( 101 001 010) #400-лишн!

4$:	TSTB	(R4)
	BPL	4$
	MOV	(R5),-(R2)
	COM	(R2)
	ASR	R1
	BEQ	8$
	BCS	4$
	TST	(R2)+
	BR	4$
; ---------------------------------------------------------------------------
8$:	CLR	(R2)		;HD$LOG & UNI
	CALL	CRC
	MOV	R2,-(R1)
; =============== S U B R O U T I N E =======================================
SETPRM:	CALL	RDY		;ибо при СТОП при вериф.глюки!
				;бывает BPL, если уже 0->R$SRES
	CLR	@#R$SRES	;программный сброс
	MOV	#6,@#R$SRES
	CALL	RDY2		;ПОРТИТ R5, R1 ! 3.7sec
	BCS	7$		;винт откл., а открыли C:
	MOV	@#HD$SEC,R0
	COM	R0
	MOV	R0,@#R$COUN	;сект.
	MOVB	@#HD$HEA,R0
	BISB	@#HD$DRV,R0
	NEG	R0		;=DEC + COM
	MOV	R0,@#R$HEAD	;гол.
	MOV	#156,(R4)	;уст.параметров
7$:	RETURN
; End of function SETPRM
; End of function PARTRD
; =============== S U B R O U T I N E =======================================
RDY4:	CALL	(PC)
; =============== S U B R O U T I N E =======================================
RDY2:	CALL	(PC)		;ПОРТИТ R5,R1
; =============== S U B R O U T I N E =======================================
RDY:	MOV	#1500,R5	;10! на 3 МГц в ПЗУ >2 с, 6 >1.1
1$:	MOV	R5,R1
	TSTB	@#R$STAT	;SEC - не раб.
	BPL	2$
	BIT	#100,@#R$STAT
	BEQ	5$
2$:	SEC
3$:	SOB	R1,3$
	SOB	R5,1$
5$:	RETURN
; End of function RDY
; End of function RDY2
; End of function RDY4

; ---------------------------------------------------------------------------
ABSLOG:	.WORD	177777,0		;псевдолог.диск для абс.адрес.
ERRTAB:	.BYTE	11,3,17,17,5,17,1,2,12,0
	.EVEN
; Это уже стартовые алгоритмы СМК -------------------------------------------
ZAGN:	MOV	R5,-(SP)
	CALL	INIT
	MOV	(SP)+,R0
	CALL	@#BOOT1$
	EMT	1

ZAG:	CALL	INIT
	CALL	@#BOOT0
	EMT	1

ZAGHDD:	CLR	R1		;загрузка с лог диска, буква которого задана в R5
	MOV	R5,R0
	BEQ	ZAG
	SUB	#101,R5 ; 'A'
	BGE	ZAGN
	JSR	R4,@#MOD$S
	MOV	R0,R5
	BR	LS2
; ------ Старт прошивки СМК -------------------------------------------------
START:	CLR	R5
LS2:	MOV	(PC),R2		;почувств.клав.на 6 МГц: > 40000 SOB
L4:	MOV	#177130,R3
	MOV	#4,R4
	MOV	#177716,R0	;все для задержки для /St1102
	BR	LS1$
; ---------------------------------------------------------------------------
STARTJ:	BR		START
; ---------------------------------------------------------------------------
LS1$:	MOV	#1000,SP
	SOB	R2,L4		;чтоб прописать как след.
	MOV	#P10,(R4)+
	MFPS	(R4)
	MOV	#60,R1		;для 10
	MOV	#42400,@#177662	;белая палитра
	MOV	#100140,R1	;признак и код раб.реж.11M
	MOV	#16200,(R0)	;страницы ANDOS
P10:	MOV	R4,(R3)
	MOV	R1,(R3)
	MOV	R2,(R3)
	TST	R5
	BNE	103$
	BR	101$
; ---------------------------------------------------------------------------
102$:	MOVB	@#177662,R5	;< 200 !
101$:	BIT	#100,(R0)	;пусть отпустят клавишу
	BEQ	102$
103$:	CMP	#3,R5
	BNE	104$
	CALL	INIT1
	EMT	1

104$:	MOV	#40,R2
	MOV	R5,R0
	SUB	R2,R5
	CMP	R5,#7
	BHI	105$
	MOVB	HITAB(R5),R2
	BEQ	ZAG
	SWAB	R2
	ASL	R2
	JMP	(R2)
; ---------------------------------------------------------------------------
105$:	SUB	#41,R5
	BIC	R2,R5
	BPL	ZAGN
	JSR	R4,@#MOD$S
	MOV	#MAIN$,R4
	.WORD	020444		; CMP	R4,-(R4)
	BNE	106$
	JSR	R2,@-(R4)
106$:	MOV	R2,R5
	BR	L4
; =============== S U B R O U T I N E =======================================
INIT1:	TST	R1
	BMI	1$
	CALL	@#100140
	BR	2$
; ---------------------------------------------------------------------------
1$:	CALL	@#150170
	MOV	#16200,@#114	;как в ANDOS
	EMT	0
2$:	MTPS	(PC)
	RETURN
; End of function INIT1
; =============== S U B R O U T I N E =======================================
INIT:	CALL	INIT1
	MOV	#43204,R3
	MOV	#16,R0
	MOV	#DISKET,R1	;рисуем дискету
01$:	COMB	(R3)+
	MOVB	(R1)+,(R3)+
	COMB	(R3)+
	ADD	#75,R3
	SOB	R0,01$
	MOVB	#77,@#43406
	TST	R2
	BNE	02$
	EMT	20
	RETURN
; ---------------------------------------------------------------------------
02$:	MOV	#SCR11,R0
	EMT	64
	MOV	#TTL,R0
	EMT	64
	RETURN
; End of function INIT

; ---------------------------------------------------------------------------
; старшие байты адресов горячего рестарта, если нажата шифт-цифра
HITAB:	.BYTE 0,100,120,130,140,150,137,157
;спрайт дискеты
DISKET:	.BYTE 377,377,377,377,377,303,0,0,303,377,303,303,303,377

SCR10:	.BYTE 233,232,224,236,221,12,31,31,31,31,31,31,31,31,233
TTL:	.ASCIZ "ROM-BIOS v2.05  (c) АльтПро 1997"
SCR11:	.BYTE 33,71,33,61,12,12,12,11,11,200
	.EVEN
; Вызов эмуляции расширенной арифметики, если он прописан в MBR -------------
EISEML:	CMP	@HD$EIS,#240
	BNE	01$
	JMP	@HD$EIS
; ---------------------------------------------------------------------------
01$:	SEC			; а если нет - то и нет.
	JMP	@4 		;отправляемся по вектору 4

; ------ целая куча пустого места, куда много чего можно поместить ----------


; ------ начало ROM-BIOS, адрес 167342, следить строго-----------------------

.IIF GT	.-167342	.ERROR	; Перекрытие кода !!!

;ROM-BIOS для 64 Кбайт и выше;
;Яч. 167664 (жел.и 167662) должна содерж. 0; 167716 - адр. ПЗП.
;Часть, начиная с BEG$R5, д.быть во всех режимах, где бывает
;обращение к BIOS (то, что до BEG$R5 - вызывается только в SYS-
;режиме, в нем подключено ПЗУ). В принципе, можно даже обрезать
;начало BEG$R5 (незадействованные точки входа) при размещении в
;ОЗУ - соотв., подключение новых п/п должно идти от конца (от
;S$). Устанавливать ROM-BIOS в ОЗУ нужно переписыванием из ПЗУ,
;так как, в частности ,последняя ячейка ROM-BIOS - это номер
;версии, несущий информацию о модели контроллера.
;	.LA	167342

. = 167342

	;Подпрограммы переписывания массивов,вызываемые из
	;RAM-BIOS,R5=177130

MOV$:	MOV	R4,(R5)
	MOV	R3,(R5)		;0 или 40000
1$:	MOV	(R0)+,(R1)+
	SOB	R2,1$
	MOV	#6,(R5)
	MOV	#2160,(R5)	;сис.страница, -> в RAM-BIOS
	RETURN
; ---------------------------------------------------------------------------
EXCH$:	MOV	R4,(R5)
	MOV	R3,(R5)
1$:	MOV	(R1),R4
	MOV	(R0),(R1)+
	MOV	R4,(R0)+
	SOB	R2,1$
	MOV	#6,(R5)
	MOV	#2160,(R5)
	RETURN
EEND:
; ---------------------------------------------------------------------------

SIGNL$:	MOV	#6,R1		;вызыв.только из SYS-страницы
				;СИГНАЛ	ОШИБКИ:	дерг.экр + звук
	MOV	#26230,R3

1$:	SUB	R1,@#177664
	MOV	R3,R0
	SOB	R0,.
	ADD	R1,@#177664
	MOV	R3,R0
	SOB	R0,.
	SOB	R1,1$

2$:	BIT	R3,R1
	BNE	3$
	MOV	R1,@#177716
3$:	SOB	R1,2$
	BR	SIGNL$

BEG$R5:	BR	S$		;====== ТОЧКИ ВХОДА П/П, в т.ч. нечет:
	BR	S$		;ВЫЗОВ:	JSR R5,@#ADDR
	BR	S$		;	[ .WORD arg1,[arg2] ]
	BR	S$
	BR	S$
	BR	S$
	BR	S$
	BR	S$
	BR	S$
	BR	S$
	BR	S$
	BR	S$
	BR	S$
	BR	S$
	BR	S$
	BR	S$
	BR	S$
CAL$N:	BR	S$
RDW$N:	BR	S$
MOV$N:	BR	S$
SAVE$:	BR	S$
D1$:	BR	S$
D3$:	BR	S$		;СТЕК ПРИ ВЫЗОВЕ:
	NOP			;	v
				;	R5
S$:	MOV	R4,-(SP)	;	R4
	MOV	R3,-(SP)	;	R3
	MFPS	-(SP)		;	PS & @#6
	MTPS	(PC)		;- при нечет.PC
	MOVB	(PC)+,R4	;-старш.байт
	.BYTE	6,6
	MOVB	(R4),1(SP)
	MFPS	(R4)		;PS	^ при СТОП
	MOV	-(R4),-(SP)	;	@#4
	MOV	#STP$,(R4)
	MOV	R5,R3
	MOV	(R3)+,-(SP)	;	арг1
	MOV	(R3)+,-(SP)	;	арг2
	MOV	-(R5),R5	;вызван.адр.
	JSR	R4,@#MOD$S
	MOV	#MAIN$-2,R4
	CMP	(R4)+,R4	;провер.налич.
	BNE	SIGNL$
	JMP	@(R4)+		;все без обращ.к стеку!
; ---------------------------------------------------------------------------
CHW$EX:	MOV	@WRK$,(R0)	;возврат из CH$WRK
	MOV	#0,(R0)		;R0=177130
	JMP	(R5)
; ---------------------------------------------------------------------------
;СОЗДАНИЕ НОВОГО СТЕКА В ОСНОВНОМ ОЗУ С ЕГО (ОЗУ) СОХРАНЕНИЕМ
;ВЫЗОВ:	JSR R5,@#NEW$SP	| .WORD top_addr,length_byte
;либо:	MOV top_addr,R0	| JSR R5,@#NEW$SP+2 | .WORD length_byte
;либо:	MOV top_addr,R0	| MOV length_byt,R1 | JSR R5,@#NEW$SP+4
;	Старый стек может располагаться в доп. памяти.
;НОРМ.ВЫХОД: разряд Z=0 (т.е. "не 0"), R0 не равно 0;
;	SP = top_addr-2, @SP = old_SP; портит R0,R1.
;НЕТ МЕСТА ДЛЯ СОХРАНЕНИЯ: Z=1, R0=0, SP = old_SP, R1 не измен.
;	Сохранение области ОЗУ происходит во внутреннем буфере
;	BIOS'а стекового типа, его размер - не менее 1000. При
;	создании нового стека необх. дополнительно  резервиро-
;	ровать min 44 байта в связи с дребезгом СТОП.
;ВОЗВРАТ В СТАРЫЙ СТЕК: MOV @SP,SP | JSR R5,@#RESTO$

NEW$SP:	MOV	(R5)+,R0	;top адр.
	MOV	(R5)+,R1	;длина
	JSR	R5,@#SAVE$
	TST	R0
	BEQ	1$
	MOV	(SP)+,R1	;R5
	MOV	SP,-(R0)	;old SP
	MOV	R1,-(R0)
	MOV	R0,SP		;new SP
1$:	RTS	R5
; ---------------------------------------------------------------------------
RET$$:	JSR	R5,@#S$+1	;т.входа возврата из п/п из
				;доп.ОЗУ (по RTS PC)
A662:	.WORD	0,0		;чтоб читались 177662,664
; ---------------------------------------------------------------------------
EX$SP:	MOV	R3,SP
EX$:	MOV	(SP)+,@#4
	MOVB	1(SP),@#6
	MTPS	(SP)+
	MOV	(SP)+,R3
RETS$:	MOV	(SP)+,R4
	RTS	R5
; ---------------------------------------------------------------------------

STP$:	SUB	(PC),(SP)
ARTI$:	RTI
; ---------------------------------------------------------------------------
A716:	.WORD	STARTJ	;177716 - адрес запуска
; ---------------------------------------------------------------------------
;ПРЯМЫЕ ТОЧКИ ВХОДА (напр., из прерываний - где невозм. JSR R5)
;Для возврата по RTI можно занести в стек адрес ARTI$.

DIR1$:	JSR	R5,@#D1$
DIR2$:	JSR	R5,@#D1$+1
DIR3$:	JSR	R5,@#D3$

;БЫСТРАЯ УСТАНОВКА/ЧТЕНИЕ WORK-РЕЖИМА + ПЕРЕДАЧА УПРАВЛЕНИЯ
;ВЫЗОВ:	JSR R5,@#CH$WRK	| .WORD mode,addr;
;либо:	MOV mode,R0		| JSR R5,@#CH$WRK+2 | .WORD addr
;либо:	MOV mode,R0		| JSR R5,@#CH$WRK+4  - вызов с возвратом,
;	mode < = 0 - чтение без установки;
;выход:	R4 = код прежнего WORK-режима; R0 портится (=177130).
;	Ничего не проверяет, не блокирует прерывания, не
;	пользуется стеком (т.е. он может быть в доп. памяти).

CH$WRK:	MOV	(R5)+,R0
	MOV	(R5)+,R5
	MOV	#CHWRK$,R4

MOD$S:	MOV	#2160,(SP)		;-> вкл.сис.режима (с RAM-BIOS)
	BR	MOD$
MOD$J:	MOV	(R4),R4			;-> вкл.режима R4 & JMP...
MOD$:	MOV	#6,@#177130		;-> включение режима R4:
	MOV	(SP)+,@#177130		;ВЫЗОВ - JSR R4,@#MOD$
MOD$0:	MOV	#0,@#177130		;CLR низя
	JMP	(R4)			;стек после перекл.не используется
; ---------------------------------------------------------------------------
			;номер версии в 167776, реально - другой
VERS:	.BYTE	205	;версия прошивки
	.BYTE	374	;код количества памяти

.IIF GT	.-170000	.ERROR	; ROM code too big
	
	.END
;

