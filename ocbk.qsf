# Analysis & Synthesis Assignments
# ================================
set_global_assignment -name TOP_LEVEL_ENTITY ocbk_top

# Import Common Settings
# ======================
source ocbk_common.qsf

set_global_assignment -name LAST_QUARTUS_VERSION 11.0

# Fitter seed: the design sits close to the sys_clk (96.65 MHz) budget on the
# vendored sdram_ctrl wait_cnt -> s_dqm/dq_out paths, and a netlist change can
# flip closure by placement luck alone (the Phase-6 tape change did: -0.106 ns
# at the default seed, same paths, no logic in them touched). Bump this when a
# functionally-unrelated change breaks setup on those paths.
set_global_assignment -name SEED 3
